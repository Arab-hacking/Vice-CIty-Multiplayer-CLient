{
    "version": 6,
    "configurePresets": [
        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 Debug (клиент под reVC x64)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/windows-x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-x64-release",
            "inherits": "windows-x64-debug",
            "displayName": "Windows x64 Release",
            "binaryDir": "${sourceDir}/build/windows-x64-release",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "linux-server",
            "displayName": "Linux — сервер, утилиты и тесты",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-server",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VC_BUILD_CLIENT": "OFF",
                "VC_BUILD_LAUNCHER": "OFF",
                "VC_BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "windows-x64-debug",   "configurePreset": "windows-x64-debug" },
        { "name": "windows-x64-release", "configurePreset": "windows-x64-release" },
        { "name": "linux-server",        "configurePreset": "linux-server" }
    ]
}
